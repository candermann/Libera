{
  "compilerOptions": {
    "target": "ES2020",
    "module": "None",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "frontend/api.ts",
    "frontend/print.ts",
    "frontend/types/**/*.d.ts"
  ]
}
